# ==============================================================================
# PLANTILLA DE CONFIGURACIÓN - SAP LITE ERP
# Copia este archivo, renombralo como '.env' y colócalo dentro de 'backend/'
# ==============================================================================

# Configuración del motor de Base de Datos (PostgreSQL en Docker)
POSTGRES_USER=tu_usuario_aqui
POSTGRES_PASSWORD=tu_contraseña_aqui
POSTGRES_DB=tu_base_datos_aqui
POSTGRES_PORT=5433
POSTGRES_HOST=127.0.0.1

# URL de Conexión utilizada por SQLAlchemy
DATABASE_URL=postgresql://usuario:password@127.0.0.1:5433/base_datos

# Seguridad y Autenticación del ERP (Tokens de Empleados)
SECRET_KEY=usa_una_cadena_aleatoria_y_larga_aqui
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60